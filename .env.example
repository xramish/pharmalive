# PostgreSQL connection
DATABASE_URL=postgres://pharmalive:pharmalive@localhost:5432/pharmalive
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# First admin account created by `npm run db:seed`
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
# Public address of the app, used inside QR codes (optional, auto-detected if empty)
APP_URL=
